#!/bin/bash

#
# This script will create a u-boot binary for movinand/mmc boot
#

# padding to 64k u-boot
cat u-boot.bin >> u-boot-2x.bin
cat u-boot.bin >> u-boot-2x.bin
split -d -a 1 -b 64k u-boot-2x.bin u-boot-64k.bin

# make BL1 u-boot (8kb)
split -d -a 2 -b 8k u-boot.bin u-boot-8k.bin

# concat the BL1 behind of padded 64k binary
cat u-boot-8k.bin00 >> u-boot-64k.bin0

# rename and chmod
mv u-boot-64k.bin0 u-boot-movi.bin
chmod 777 u-boot-movi.bin

# remove temp files
rm -f u-boot-8k*
rm -f u-boot-64k*
rm -f u-boot-2x.bin
