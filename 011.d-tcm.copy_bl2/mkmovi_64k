#!/bin/bash

#
# This script will create a u-boot binary for movinand/mmc boot
#

# padding to 64k d-tcm
cat d-tcm.bin >> d-tcm-2x.bin
cat d-tcm.bin >> d-tcm-2x.bin
split -d -a 1 -b 64k d-tcm-2x.bin d-tcm-64k.bin

# make BL1 d-tcm (8kb)
split -d -a 2 -b 8k d-tcm.bin d-tcm-8k.bin

# concat the BL1 behind of padded 64k binary
cat d-tcm-8k.bin00 >> d-tcm-64k.bin0

# rename and chmod
mv d-tcm-64k.bin0 u-boot-movi.bin
chmod 777 u-boot-movi.bin

# remove temp files
rm -f d-tcm-8k*
rm -f d-tcm-64k*
rm -f d-tcm-2x.bin
